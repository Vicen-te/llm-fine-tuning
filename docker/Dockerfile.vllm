# Patched vLLM image for serving the text-only Qwen3.5 fine-tune.
#
# Stock vLLM 0.23.0 ships the text-only Qwen3.5 model classes but only registers
# the multimodal ...ForConditionalGeneration variants, so a text-only checkpoint
# falls back to the multimodal class and crashes
# (AttributeError: 'Qwen3_5TextConfig' object has no attribute 'vision_config';
# see https://github.com/vllm-project/vllm/issues/39231).
# patch_vllm_qwen35.py adds the missing text-generation registry entries.
#
# Built FROM the stock image (already pulled locally), so this only adds two
# tiny layers and re-downloads nothing.
FROM vllm/vllm-openai:latest
COPY patch_vllm_qwen35.py /tmp/patch_vllm_qwen35.py
RUN python3 /tmp/patch_vllm_qwen35.py

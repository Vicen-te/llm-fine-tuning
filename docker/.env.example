# Copy to `docker/.env` (or `.env` at repo root, docker-compose picks both up).
#
# MODEL_ID — what the vLLM container loads. Either:
#   - a Hugging Face Hub id (e.g. YOUR_HF_USERNAME/qwen3.5-2b-sql), or
#   - a path *inside* the container (defaults map /models -> ../outputs).
# Examples:
#   MODEL_ID=YOUR_HF_USERNAME/qwen3.5-2b-sql
#   MODEL_ID=/models/qwen3.5-2b-sql-merged

MODEL_ID=YOUR_HF_USERNAME/qwen3.5-2b-sql

# Optional. Override which host directory mounts to /models inside vLLM.
# Default ../outputs is fine if you trained locally.
# MODEL_DIR=../outputs

# Needed when MODEL_ID points to a private Hub repo. Public models don't need it.
HF_TOKEN=

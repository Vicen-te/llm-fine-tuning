# Slim image for the FastAPI wrapper that fronts the vLLM container.
# vLLM itself is NOT installed here — it lives in the sister container
# (vllm/vllm-openai). This image only needs httpx, fastapi, uvicorn, and our
# tiny `sql_ft` package (for prompts.build_messages + eval_sql.clean_sql_output).

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps: curl is used by docker-compose healthcheck.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# We only need a small slice of the requirements to run the wrapper. Listing
# them explicitly keeps the layer small and the image rebuild fast.
RUN pip install --upgrade pip \
 && pip install \
        "fastapi>=0.115" \
        "uvicorn[standard]>=0.32" \
        "httpx>=0.27" \
        "pydantic>=2.0" \
        "sqlglot>=25.0" \
        "sacrebleu>=2.4"

# Copy only the parts we actually need at runtime.
COPY src/sql_ft /app/sql_ft
COPY scripts/serve_vllm.py /app/serve_vllm.py

# Make `import sql_ft.*` work without a setup install.
ENV PYTHONPATH=/app

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=30s \
    CMD curl -fsS http://localhost:8080/healthz || exit 1

CMD ["uvicorn", "serve_vllm:app", "--host", "0.0.0.0", "--port", "8080"]

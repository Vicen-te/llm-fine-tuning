# Copy to `.env` and fill in. `.env` is git-ignored.

# Hugging Face Hub token (write scope, needed to push dataset/model/adapter).
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Your Hugging Face username (used by push scripts to compose repo IDs).
HF_USERNAME=YOUR_HF_USERNAME

# Optional: Weights & Biases (training metrics). Leave empty to disable.
WANDB_API_KEY=
WANDB_PROJECT=sql-ft
